# FORGE Trading Agent — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# Render: ces variables sont dans le dashboard (render.yaml)

# Alpaca Paper Trading
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...

# Etherscan (wallet tracking)
ETHERSCAN_API_KEY=...

# Supabase (database)
SUPABASE_URL=https://...supabase.co
